  "moonread/moonread/src/epub",
  "moonread/moonread/src/jsonio",
  "moonread/moonread/src/render",
  "moonread/moonread/src/rules",
  "moonread/moonread/src/toc",
  "moonread/moonread/src/util",
  "moonread/moonread/src/zipio",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
}
